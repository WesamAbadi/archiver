# Production build env (Vite loads this only for `vite build`).
#
# VITE_API_URL is an ORIGIN ONLY — no trailing slash, NO `/api` suffix. Every
# call appends `/api` itself (see src/lib/env.ts), which is what stops the old
# `api/api/auth/...` double-prefix bug from coming back.
#
# Tracked in git on purpose: the API origin is not a secret, and a fresh clone
# should build against the right Worker without any setup.
VITE_API_URL=https://archivedrop-api.wesam-w-abadi.workers.dev
