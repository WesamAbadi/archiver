# ─────────────────────────────────────────────────────────────────────────────
# ArchiveDrop frontend — environment variables (Vite)
# Copy to .env (dev) — for production set these in Cloudflare Pages:
#   Pages project → Settings → Environment variables
# ─────────────────────────────────────────────────────────────────────────────

# API origin ONLY — no /api suffix, no trailing slash.
#   Local dev (Vite proxy):        leave EMPTY
#   Workers dev domain:            https://archivedrop-api.<your-subdomain>.workers.dev
#   Custom domain (recommended):   https://api.yourdomain.com
VITE_API_URL=

# Google OAuth Web client ID (same value as the backend's GOOGLE_CLIENT_ID).
# Authorized JavaScript origins in Google Cloud Console must include your
# frontend origin(s): http://localhost:5173 and your production Pages domain.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
