# ---------------------------------------------------------------------------
# Local development (wrangler dev fallback + drizzle-kit migrations)
# Copy to .env — never commit the real .env
# ---------------------------------------------------------------------------

# Direct Postgres connection string. Used by:
#   - drizzle-kit generate/migrate (always)
#   - wrangler dev when no HYPERDRIVE binding is configured
DATABASE_URL="postgresql://user:password@localhost:5432/archivedrop"

# In production these are set via `npx wrangler secret put <NAME>`
# GOOGLE_CLIENT_ID   — Google OAuth Web client ID (audience check)
# JWT_SECRET         — session signing secret (use 32+ random chars)
# R2_ACCOUNT_ID      — Cloudflare account id
# R2_ACCESS_KEY_ID   — R2 S3 API token (Object Read & Write, scoped to the media bucket)
# R2_SECRET_ACCESS_KEY
