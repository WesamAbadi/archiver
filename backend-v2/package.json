{
  "name": "archivedrop-backend-v2",
  "version": "2.0.0",
  "description": "ArchiveDrop API — Cloudflare Workers + Hono + Drizzle + R2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.6.0",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
